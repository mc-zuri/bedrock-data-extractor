# Copy to .env: every pnpm step reads it. Relative paths are the repo's.

# The bedrock-data checkout the steps write into (and whose schemas they check what they write against)
BEDROCK_DATA_DIR=../bedrock-data

# Where a build's zips are downloaded to, and its server unpacked, while it is extracted; each is deleted once its
# build is done (a failed one keeps them, and the agent's log)
CACHE_DIR=cache

# Builds downloaded and extracted at once
JOBS=3

# The first of the UDP ports the servers run on, two each
SERVER_PORT_BASE=41032

# Linux: where OpenSSL 1.1 is, which the servers before 1.19.40 load (Ubuntu 24.04 has none: focal's libssl1.1)
# LD_LIBRARY_PATH=/opt/libssl1.1/usr/lib/x86_64-linux-gnu
